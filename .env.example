# 无需填写应用密钥或管理员密码：密钥首次启动自动生成，管理员在网页设置密码。
# 普通账号登录无需填写；可在服务器私有 .env 配置自己的应用凭据以避免共享默认应用的限额。
# 旧版 TG_API_ID/TG_API_HASH 仍兼容；启用 TeleBox 的账号请在登录表单填写专属凭据。
# TG_MANAGE_TG_API_ID=123456
# TG_MANAGE_TG_API_HASH=your_32_character_api_hash_here
# 已有 .env 中的 SIGNPULSE_TG_API_ID/HASH 仍可读取，升级时可择机迁移。

# 可选：允许跨域访问后端 API 的前端来源，逗号分隔
# APP_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 可选配置
PORT=8080
APP_DATA_DIR=/data

# 面板 2FA TOTP 时间窗口容差（默认 0，仅当前 30s；可设 1 表示允许前后各 1 个窗口）
# APP_TOTP_VALID_WINDOW=1

# Telegram Session 模式（默认 file）
# TG_SESSION_MODE=file
# TG_GLOBAL_CONCURRENCY=2  # 2 核宿主机上的并发连接上限；账号总数可以大于此值

# 可选：TeleBox 原生插件运行设置，Compose 会传给每个账号的进程。
# 单个账号的插件密钥和 HTTP 代理请写入 data/telebox/<账号名SHA-256>/.env，权限设为 600。
# TB_PREFIX=. 。 $
# TB_LISTENER_HANDLE_EDITED=kitt
# TB_CMD_IGNORE_EDITED=true

# 任务执行超时（秒，默认 300 即 5 分钟）
# 是否开启 Swagger UI / ReDoc / OpenAPI 规范文档（默认关闭，生产环境建议保持关闭；设为 1/true 开启）
# ENABLE_API_DOCS=false
